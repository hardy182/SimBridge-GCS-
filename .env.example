# SimBridge GCS Environment Configuration Example
# Copy to .env to customize local server defaults

# Server Host and Port
SIMBRIDGE_HOST=0.0.0.0
SIMBRIDGE_PORT=8050
SIMBRIDGE_LOG_LEVEL=info

# Default Simulator on Startup: 'none', 'mock', 'gazebo', 'px4', 'blender'
SIMBRIDGE_DEFAULT_SIMULATOR=none

# Gazebo Transport Configuration
GZ_PARTITION=
GAZEBO_WORLD_NAME=default
GAZEBO_MODEL_NAME=quadcopter
GAZEBO_CAMERA_TOPIC=/camera/image
GAZEBO_POSE_TOPIC=/world/default/dynamic_pose/info

# PX4 SITL MAVLink Connection
PX4_MAVLINK_CONNECTION=udp:127.0.0.1:14550
PX4_BAUD_RATE=57600

# Video Streaming Settings
STREAM_JPEG_QUALITY=80
STREAM_TARGET_FPS=30
